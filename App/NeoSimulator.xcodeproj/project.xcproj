  "targets": [
    {
      "name": "NeoSimulatorGuestSettings",
      "id": "2BD2B139D214453FA1723960",
      "product": "Products/NeoSimulatorGuestSettings",
      "product-type": "tool",
      "build-phases": [
        "compile-sources",
        "frameworks",
      ],
      "build-settings": {
        "ARCHS": "arm64",
        "CLANG_ENABLE_OBJC_ARC": "YES",
        "CODE_SIGN_ENTITLEMENTS": "NeoSimulatorGuestSettings/GuestVirtual.entitlements",
        "CODE_SIGN_IDENTITY": "-",
        "CODE_SIGN_STYLE": "Manual",
        "IPHONEOS_DEPLOYMENT_TARGET": "17.0",
        "LD_ENTITLEMENTS_SECTION": "$(SRCROOT)/NeoSimulatorGuestSettings/GuestVirtual.entitlements",
        "OTHER_LDFLAGS": [
          "$(inherited)",
          "-Xlinker",
          "-weak_library",
          "-Xlinker",
          "\"$(SRCROOT)/NeoSimulatorGuestSettings/DisplayAndBrightnessSettings.tbd\"",
        ],
        "PRODUCT_NAME": "NeoSimulatorGuestSettings",
        "SDKROOT": "iphonesimulator",
        "SKIP_INSTALL": "YES",
        "SUPPORTED_PLATFORMS": "iphonesimulator",
      },
    }, {
      "name": "NeoSimulator",
      "id": "0B7837795C8C6DC7CC39C54C",
      "product": "Products/NeoSimulator.app",
      "product-type": "application",
      "legacy-provisioning-style": "manual",
      "dependencies": [
        "NeoSimulatorRenderer",
        "NeoSimulatorGuestSettings",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Guest Settings",
          "bundle-base-path": "contents-directory",
          "relative-path": "Helpers",
        }, {
          "kind": "copy",
          "name": "Embed Renderer",
          "bundle-base-path": "contents-directory",
          "relative-path": "Applications",
        },
      ],
      "package-product-members": [
        {
          "product-name": "XcodeSimulatorHost",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "ABIBridge",
          "product-name": "ABIBridge",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "CODE_SIGN_ENTITLEMENTS": "NeoSimulator/NeoSimulator.entitlements",
        "CODE_SIGN_IDENTITY": "-",
        "CODE_SIGN_STYLE": "Manual",
        "COMBINE_HIDPI_IMAGES": "YES",
        "CURRENT_PROJECT_VERSION": "1",
        "GENERATE_INFOPLIST_FILE": "NO",
        "GENERATE_PKGINFO_FILE": "NO",
        "INFOPLIST_FILE": "NeoSimulator/Info.plist",
