  "targets": [
    {
      "name": "NeoSimulatorGuestSettings",
      "id": "2BD2B139D214453FA1723960",
      "product": "Products/NeoSimulatorGuestSettings",
      "product-type": "tool",
      "build-phases": [
        "compile-sources",
        "frameworks",
      ],
      "build-settings": {
        "ARCHS": "arm64",
        "CLANG_ENABLE_OBJC_ARC": "YES",
        "CODE_SIGN_ENTITLEMENTS": "NeoSimulatorGuestSettings/GuestSettings.entitlements",
        "CODE_SIGN_IDENTITY": "-",
